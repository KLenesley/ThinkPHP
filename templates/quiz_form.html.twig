<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Quiz</title>
</head>
<body>
    <form action="quiz_process.php" method="POST">

        {% set i = 0 %}        
        {% for quiz in quizzes %}    
            <h1>{{ dump(quiz.id) }}</h1>
            <h1>{{ dump(i) }}</h1>
            {% if quiz.id != id %}
                <label for="question-{{ quiz.id }}">{{ quiz.question }}</label><br>
            {% endif %}
            {% set i = quiz.id %}        
            
            {% for answer in quiz.answers %}
                <input type="radio" name="{{ i }}" id="{{ answer }}" value="{{ answer }}">
                <label>{{ answer }}</label><br>
            {% endfor %}
        {% endfor %}

        <br>

        <input type="submit" value="Envoyer">
    </form>
</body>
</html>