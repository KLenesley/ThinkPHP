<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Quiz</title>
</head>
<body>
    <form action="quiz_process.temp.php" method="POST">

        {% set i = 0 %}
        {% for quiz in quizzes %}
            {% set i = i + 1 %}
            <label for="question-{{ i }}">{{ quiz.question }}</label><br>
            {% for answer in quiz.answers %}
                <input type="radio" name="{{ i }}" id="{{ answer }}" value="{{ answer }}">
                <label>{{ answer }}</label><br>
            {% endfor %}
        {% endfor %}

        <br>

        <input type="submit" value="Envoyer">
    </form>
</body>
</html>